# Frontend env vars (Vite uses import.meta.env.VITE_*)
#
# VITE_API_URL — base URL of the backend API.
# Leave UNSET in dev (Vite proxies /api to http://localhost:8080) and in Docker
# (nginx proxies /api to the backend container). Set ONLY when deploying to a
# static host (e.g. Vercel) that doesn't proxy /api.
#
# Example for a Vercel deployment with a Render backend:
# VITE_API_URL=https://openhospital-rms-api.onrender.com
#
VITE_API_URL=