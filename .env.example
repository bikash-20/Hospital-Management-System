# ── Supabase PostgreSQL ──────────────────────────────────
# Go to https://supabase.com/dashboard → your project → Settings → Database
# Copy the "Connection string" → URI format
#
# Example:
# DATABASE_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
#
DATABASE_URL=jdbc:postgresql://YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# ── JWT ──────────────────────────────────────────────────
# Change this to a strong random secret for production
# Generate one: openssl rand -base64 48
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRATION_MS=86400000

# ── Frontend API URL (only needed for local dev, Docker auto-proxies) ──
# VITE_API_URL=http://localhost:8080
